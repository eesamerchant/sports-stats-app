# ─────────────────────────────────────────────
# Supabase — get these from your project's API settings
# https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by admin routes and background jobs.
# NEVER prefix with NEXT_PUBLIC_. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooled connection string (for server routes).
# Find under Database → Connection string → "Transaction" mode pooler.
# This is what keeps Vercel functions from exhausting Postgres connections.
DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
